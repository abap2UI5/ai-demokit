{
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      // TEMPORARY: the ports use _bind( json = abap_true ) (apps 118/341 - the
      // sap.ui.integration Card manifests), which lives on this abap2UI5 branch
      // until it is merged. The 702 branch is rebuilt from main by the
      // framework's auto_downport, so it cannot carry the parameter before the
      // merge; pointing at the feature branch keeps this build honest until it
      // does. MUST go back to "702" before this change is merged - same rule as
      // the linter pin in STATUS.md. (The stale pin of the already-merged
      // ai-demokit-next-steps branch that sat here is dropped with it: the
      // branch is gone upstream, so this config could not resolve at all.)
      "branch": "claude/portier-demokit-sap-ui-samples-9ek4hj",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "definitions_top": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
