{
  // The view-chain house layout, over the WHOLE tree.
  //
  // This used to be scripts/chain-format.mjs, a second implementation of a
  // rule the linter already has: `chain-house-layout` judges one call per line
  // including attributes, four spaces per level, and `shut( )` in the column
  // of the `open( )` it closes. The rule was built FROM this corpus's layout
  // unification (2026-08), which is why the switch cost nothing - measured at
  // zero findings over all 431 classes / 480 views before it was made.
  //
  // Why a config of its own rather than a `rules` entry on view-gates: this
  // has to cover src/03 as well, and view-gates only ever sees files that have
  // a meta sidecar - the fourteen hand-written collection classes have none.
  // The layout is a property of the SOURCE, not of a port, so it is checked
  // over the tree.
  //
  // `npm run fmt:chains` applies it.
  "$schema": "./node_modules/@abap2ui5/linter/data/abap2ui5lint.schema.json",

  "paths": ["src"],
  "ui5": "1.71",
  "distribution": "sapui5",

  // Layout is read off the ABAP source; nothing here needs a browser, and the
  // render gate would turn a five-second check into a multi-minute one.
  "render": false,

  // …and the property gate is off for the same reason it is not this check's
  // business: whether a member exists on the 1.71 floor is judged by
  // view-gates, against the meta sidecars and their POST_171 deviations. Left
  // on, this config would re-report those findings with none of that policy
  // applied - a second, dumber opinion about work that is already gated.
  //
  // This is one line again as of 2026-08-30. It used to be fifteen `false`
  // entries, because `properties: false` took the CHAIN rules down with it -
  // they were emitted from the same pass, so a layout-only run passed
  // everything and looked green doing it. The linter separates the two now:
  // the snapshot-backed walk stays behind this flag, the ABAP-side rules run
  // either way. Two of those fifteen were linter defects rather than policy
  // (`invalid-aggregation-child` on ObjectPageSubSection.blocks, and
  // `unknown-property` on a member newer than the pinned snapshot) and both
  // disappear with the property gate itself.
  "properties": false,

  "rules": {
    // src/zz_dev is where abap2UI5/mcp-server's deploy_app writes the class an
    // agent is working on - not corpus, not committed, and it must not fail a
    // gate. scripts/lib/src-tree.mjs is the same list for the scripts that
    // walk the tree themselves.
    "chain-house-layout": { "severity": "warning", "exclude": ["src/zz_dev/"] },

    // What remains after the property gate is off: the ABAP-side rules, which
    // read the class rather than the view tree and are therefore unaffected by
    // it. All six are view-gates' business for the same reason the version
    // family was - it reads them against the meta sidecars, where an advisory
    // budget and a declared deviation decide them. Measured, not guessed: these
    // are exactly the types that fire over src with the property gate off.
    //
    // A rule the linter grows LATER is not in this list and will fire here on
    // the next bump. That is deliberate and matches how view-gates treats new
    // advisory rules: the bump PR is where the decision belongs.
    "hardcoded-binding-path": false,
    "icon-too-new": false,
    "live-event-roundtrip": false,
    "event-without-handler": false,
    "frontend-action-too-new": false,
    "escape-sequence-in-backtick": false
  }
}
